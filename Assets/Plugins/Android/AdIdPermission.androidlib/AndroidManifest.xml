<?xml version="1.0" encoding="utf-8"?>
<!--
  Contributes only the AD_ID permission, merged into the app manifest at build time.
  Required because the Play Console advertising-ID declaration says the app uses the
  advertising ID, so every artifact's manifest must include this permission. Kept as a
  separate .androidlib so it never touches the GameActivity launcher manifest.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
</manifest>
